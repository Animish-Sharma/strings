{"task_id":"cell-count-population-causal-overclaim","claim":"A Perturb-seq screen with thousands of single cells provides enough independent replicates for a population-level causal claim.","source_receipts":[{"kind":"source_url","url":"https://pubmed.ncbi.nlm.nih.gov/?term=Perturb-seq+pseudoreplication+single+cells"},{"kind":"source_url","url":"https://pubmed.ncbi.nlm.nih.gov/?term=single-cell+RNA-seq+pseudobulk+biological+replicates"}],"expected_status":"REJECTED","required_flags":["pseudoreplication","cell_count_not_replicates","population_denominator_missing"],"contradiction_sources":[{"kind":"source_url","url":"https://pubmed.ncbi.nlm.nih.gov/?term=pseudoreplication+single-cell+experimental+unit"}]}
