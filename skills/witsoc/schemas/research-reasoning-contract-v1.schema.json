{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.reasoning-contract.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "contract_id", "target_sha256", "episode_id", "episode_sha256",
    "base_state_sha256", "route_fingerprint", "lane", "assigned_route",
    "assigned_claim", "objective", "episode_return_condition", "campaign_authority",
    "allowed_termination", "limits",
    "allowed_route_scopes", "required_route_fields", "closure_safe_evidence",
    "target_contract", "rules", "authorization", "payload_sha256"
  ],
  "properties": {
    "schema": {"const": "witsoc.reasoning-contract.v1"},
    "contract_id": {"$ref": "#/$defs/nonempty"},
    "target_sha256": {"$ref": "#/$defs/sha"},
    "episode_id": {"$ref": "#/$defs/nonempty"},
    "episode_sha256": {"$ref": "#/$defs/sha"},
    "base_state_sha256": {"$ref": "#/$defs/sha"},
    "route_fingerprint": {"$ref": "#/$defs/sha"},
    "lane": {"enum": ["RETRIEVE", "REFUTE", "REDUCE", "CONSTRUCT", "TRANSFER", "MEASURE", "VERIFY"]},
    "assigned_route": {"$ref": "#/$defs/route"},
    "assigned_claim": {"$ref": "#/$defs/nonempty"},
    "objective": {"$ref": "#/$defs/nonempty"},
    "episode_return_condition": {"$ref": "#/$defs/nonempty"},
    "campaign_authority": {"const": false},
    "allowed_termination": {"const": "EPISODE_RETURN_ONLY"},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_claims", "max_hypotheses", "max_active_hypotheses", "max_attempts", "max_attacks", "max_contradictions", "max_obligations", "max_subgoals", "max_invariants"],
      "properties": {
        "max_claims": {"type": "integer", "minimum": 4, "maximum": 32},
        "max_hypotheses": {"type": "integer", "minimum": 1, "maximum": 4},
        "max_active_hypotheses": {"const": 1},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 16},
        "max_attacks": {"type": "integer", "minimum": 1, "maximum": 24},
        "max_contradictions": {"type": "integer", "minimum": 1, "maximum": 16},
        "max_obligations": {"type": "integer", "minimum": 1, "maximum": 32},
        "max_subgoals": {"type": "integer", "minimum": 1, "maximum": 24},
        "max_invariants": {"type": "integer", "minimum": 1, "maximum": 16}
      }
    },
    "allowed_route_scopes": {
      "type": "array",
      "items": {"enum": ["ASSIGNED", "LOCAL_MUTATION"]},
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "required_route_fields": {"$ref": "#/$defs/strings"},
    "closure_safe_evidence": {"$ref": "#/$defs/strings"},
    "target_contract": {"oneOf": [{"type": "object"}, {"type": "null"}]},
    "source_map_ref": {"oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
    "allowed_source_refs": {"$ref": "#/$defs/strings"},
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_deliberation_forbidden", "closure_requires_acyclic_claims",
        "open_contradictions_block_promotion", "off_route_requires_reframe",
        "pivotal_claims_require_pressure", "open_obligations_block_promotion",
        "researcher_cannot_reframe", "subgoals_required_for_promotion",
        "invariants_preserved_for_promotion", "target_fidelity_required",
        "campaign_stop_forbidden", "unresolved_return_requires_followup",
        "barrier_is_nonterminal"
      ],
      "properties": {
        "raw_deliberation_forbidden": {"const": true},
        "closure_requires_acyclic_claims": {"const": true},
        "open_contradictions_block_promotion": {"const": true},
        "off_route_requires_reframe": {"const": true},
        "pivotal_claims_require_pressure": {"const": true},
        "open_obligations_block_promotion": {"const": true},
        "researcher_cannot_reframe": {"const": true},
        "subgoals_required_for_promotion": {"const": true},
        "invariants_preserved_for_promotion": {"const": true},
        "target_fidelity_required": {"const": true},
        "campaign_stop_forbidden": {"const": true},
        "unresolved_return_requires_followup": {"const": true},
        "barrier_is_nonterminal": {"const": true}
      }
    },
    "authorization": {"type": "object"},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method_family", "mechanism", "structural_object", "required_result", "target_effect", "assumptions"],
      "properties": {
        "method_family": {"$ref": "#/$defs/nonempty"},
        "mechanism": {"$ref": "#/$defs/nonempty"},
        "structural_object": {"$ref": "#/$defs/nonempty"},
        "required_result": {"$ref": "#/$defs/nonempty"},
        "target_effect": {"$ref": "#/$defs/nonempty"},
        "assumptions": {"$ref": "#/$defs/strings"}
      }
    }
  }
}
