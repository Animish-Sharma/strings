{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.bridge-envelope.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "envelope_id", "source", "destination", "source_message_type", "source_content_sha256", "message_type", "message_schema_id", "adapter_id", "adapter_contract_sha256", "target_sha256", "correlation_id", "causation_id", "scope_owner", "preserved_invariants", "losses", "conflict_refs", "content_sha256", "payload", "evidence_refs", "payload_sha256"],
  "properties": {
    "schema": {"const": "witsoc.bridge-envelope.v2"},
    "envelope_id": {"$ref": "#/$defs/nonempty"},
    "source": {"$ref": "#/$defs/nonempty"},
    "destination": {"$ref": "#/$defs/nonempty"},
    "source_message_type": {"$ref": "#/$defs/nonempty"},
    "source_content_sha256": {"$ref": "#/$defs/sha"},
    "message_type": {"$ref": "#/$defs/nonempty"},
    "message_schema_id": {"$ref": "#/$defs/nonempty"},
    "adapter_id": {"$ref": "#/$defs/nonempty"},
    "adapter_contract_sha256": {"$ref": "#/$defs/sha"},
    "target_sha256": {"$ref": "#/$defs/sha"},
    "correlation_id": {"$ref": "#/$defs/nonempty"},
    "causation_id": {"type": ["string", "null"]},
    "scope_owner": {"$ref": "#/$defs/nonempty"},
    "preserved_invariants": {"$ref": "#/$defs/strings"},
    "losses": {"$ref": "#/$defs/strings"},
    "conflict_refs": {"$ref": "#/$defs/strings"},
    "content_sha256": {"$ref": "#/$defs/sha"},
    "payload": {"type": "object"},
    "evidence_refs": {"$ref": "#/$defs/strings"},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "strings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
