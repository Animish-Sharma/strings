{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.request.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "statement", "intent", "constraints", "requested_output", "payload_sha256"],
  "properties": {
    "schema": {"const": "witsoc.request.v2"},
    "request_id": {"$ref": "#/$defs/nonempty"},
    "statement": {"$ref": "#/$defs/nonempty"},
    "intent": {"type": "string"},
    "constraints": {"$ref": "#/$defs/strings"},
    "requested_output": {"$ref": "#/$defs/nonempty"},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "strings": {"type": "array", "items": {"type": "string"}},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
