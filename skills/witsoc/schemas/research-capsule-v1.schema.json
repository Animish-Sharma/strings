{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.capsule.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "capsule_id", "target_sha256", "base_state_sha256", "mode", "role", "domains", "target", "frontier_slice", "source_refs", "obstructions", "capabilities", "contracts", "context_budget", "estimated_tokens", "omissions", "payload_sha256"],
  "properties": {
    "schema": {"const": "witsoc.capsule.v1"},
    "capsule_id": {"$ref": "#/$defs/nonempty"},
    "target_sha256": {"$ref": "#/$defs/sha"},
    "base_state_sha256": {"$ref": "#/$defs/sha"},
    "mode": {"$ref": "#/$defs/nonempty"},
    "role": {"enum": ["explorer", "generator", "researcher"]},
    "domains": {"$ref": "#/$defs/strings"},
    "target": {"type": "object"},
    "frontier_slice": {"type": "array", "items": {"type": "object"}},
    "source_refs": {"$ref": "#/$defs/strings"},
    "obstructions": {"type": "array", "items": {"type": "object"}},
    "capabilities": {"$ref": "#/$defs/strings"},
    "contracts": {"$ref": "#/$defs/strings"},
    "context_budget": {"type": "integer", "minimum": 256},
    "estimated_tokens": {"type": "integer", "minimum": 0},
    "omissions": {"$ref": "#/$defs/strings"},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "strings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
