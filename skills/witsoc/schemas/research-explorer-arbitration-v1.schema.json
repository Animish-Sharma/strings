{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.explorer-arbitration.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "arbitration_id", "target_sha256", "base_revision",
    "base_state_sha256", "explorer_state_sha256", "phase", "return_ref",
    "impact", "evidence_ceiling", "route_disposition", "obstruction_disposition",
    "action", "basis_refs", "alternatives", "selected_proposal_id", "selected_route",
    "proposal_set_sha256", "changed_axis", "reason", "frontier_delta",
    "source_coverage_status", "target_contract", "stop_review_ref", "status_authority",
    "payload_sha256"
  ],
  "properties": {
    "schema": {"const": "witsoc.explorer-arbitration.v1"},
    "arbitration_id": {"$ref": "#/$defs/nonempty"},
    "target_sha256": {"$ref": "#/$defs/sha"},
    "base_revision": {"type": "integer", "minimum": 0},
    "base_state_sha256": {"$ref": "#/$defs/sha"},
    "explorer_state_sha256": {"$ref": "#/$defs/sha"},
    "phase": {"enum": ["TRIAGE", "RETURN_ARBITRATION", "POST_ARBITRATION"]},
    "return_ref": {"type": ["string", "null"]},
    "impact": {"enum": ["INITIAL_TRIAGE", "TARGET_PROGRESS", "LOCAL_PRODUCT", "ROUTE_REFUTED", "CORE_SHARPENED", "EMPIRICAL_SIGNAL", "SOURCE_UPDATE", "EXTERNAL_WAIT", "NO_PROGRESS", "CONFLICT"]},
    "evidence_ceiling": {"enum": ["EXACT", "SOURCE_VERIFIED", "COMPUTATIONAL_BOUNDED", "EMPIRICAL", "SEARCH_BOUNDED", "UNKNOWN"]},
    "route_disposition": {"enum": ["LIVE", "EXHAUSTED", "REFRAME_REQUIRED", "WAITING", "NOT_APPLICABLE"]},
    "obstruction_disposition": {"enum": ["ACCEPT", "REJECT", "DEFER", "NOT_APPLICABLE"]},
    "action": {"enum": ["REFRAME_FRONTIER", "EXPAND_FRONTIER", "PAUSE_WITH_FRONTIER", "DIRECT_ANSWER", "WORK_ITEM_TO_GENERATOR", "WORK_ITEM_TO_RESEARCHER", "RETRY_WITH_MUTATION", "DEMOTE", "WAIT_EXTERNAL", "HONEST_STOP"]},
    "basis_refs": {"$ref": "#/$defs/strings_nonempty"},
    "alternatives": {"$ref": "#/$defs/strings"},
    "selected_proposal_id": {"type": ["string", "null"]},
    "selected_route": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/selected_route"}]},
    "proposal_set_sha256": {"type": ["string", "null"]},
    "changed_axis": {"type": "string"},
    "reason": {"$ref": "#/$defs/nonempty"},
    "frontier_delta": {"$ref": "#/$defs/frontier_delta"},
    "source_coverage_status": {"enum": ["NOT_STARTED", "PARTIAL", "BOUNDED_COMPLETE"]},
    "source_map_ref": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "source_refs": {"$ref": "#/$defs/strings"},
    "source_verified_refs": {"$ref": "#/$defs/strings"},
    "target_contract": {"type": "object"},
    "stop_review_ref": {"type": ["string", "null"]},
    "status_authority": {"const": false},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}, "uniqueItems": true},
    "strings_nonempty": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}, "uniqueItems": true},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "frontier_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["additions", "relinks", "edge_assertions", "active_ids", "accepted_obstructions"],
      "properties": {
        "additions": {"type": "array", "items": {"$ref": "#/$defs/frontier_item"}},
        "relinks": {"type": "array", "items": {"$ref": "#/$defs/relink"}},
        "edge_assertions": {"type": "array", "items": {"$ref": "#/$defs/edge_assertion"}},
        "active_ids": {"$ref": "#/$defs/strings"},
        "accepted_obstructions": {"type": "array", "items": {"$ref": "#/$defs/obstruction"}}
      }
    },
    "frontier_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "kind", "statement", "target_sha256", "status", "dependencies", "evidence_refs", "route_fingerprint", "admission_ref"],
      "properties": {
        "item_id": {"$ref": "#/$defs/nonempty"},
        "kind": {"$ref": "#/$defs/nonempty"},
        "statement": {"$ref": "#/$defs/nonempty"},
        "target_sha256": {"$ref": "#/$defs/sha"},
        "status": {"const": "OPEN"},
        "dependencies": {"$ref": "#/$defs/strings"},
        "evidence_refs": {"$ref": "#/$defs/strings"},
        "route_fingerprint": {"type": ["string", "null"]},
        "admission_ref": {"type": "null"}
      }
    },
    "relink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "dependencies", "relations"],
      "properties": {
        "item_id": {"$ref": "#/$defs/nonempty"},
        "dependencies": {"$ref": "#/$defs/strings"},
        "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency_id", "relation", "evidence_refs"],
      "properties": {
        "dependency_id": {"$ref": "#/$defs/nonempty"},
        "relation": {"enum": ["EQUIVALENT_TO", "NECESSARY_FOR", "SUFFICIENT_FOR", "IMPLIES", "REDUCES_TO", "BLOCKS", "DISCRIMINATES", "SUPPORTS", "EMPIRICAL_ONLY"]},
        "evidence_refs": {"$ref": "#/$defs/strings"}
      }
    },
    "edge_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_id", "to_id", "relation", "evidence_refs"],
      "properties": {
        "from_id": {"$ref": "#/$defs/nonempty"},
        "to_id": {"$ref": "#/$defs/nonempty"},
        "relation": {"enum": ["EQUIVALENT_TO", "NECESSARY_FOR", "SUFFICIENT_FOR", "IMPLIES", "REDUCES_TO", "BLOCKS", "DISCRIMINATES", "SUPPORTS", "EMPIRICAL_ONLY"]},
        "evidence_refs": {"$ref": "#/$defs/strings"}
      }
    },
    "selected_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "proposal_sha256", "route_fingerprint", "core_fingerprint", "route_terms", "core_terms", "operator_id", "mechanism", "invariant", "required_result", "failure_signature", "failure_domain", "revival_predicate", "evidence_refs"],
      "properties": {
        "proposal_id": {"$ref": "#/$defs/nonempty"},
        "proposal_sha256": {"$ref": "#/$defs/sha"},
        "route_fingerprint": {"$ref": "#/$defs/sha"},
        "core_fingerprint": {"$ref": "#/$defs/sha"},
        "route_terms": {"$ref": "#/$defs/strings"},
        "core_terms": {"$ref": "#/$defs/strings"},
        "operator_id": {"$ref": "#/$defs/nonempty"},
        "mechanism": {"$ref": "#/$defs/nonempty"},
        "invariant": {"$ref": "#/$defs/nonempty"},
        "required_result": {"$ref": "#/$defs/nonempty"},
        "failure_signature": {"$ref": "#/$defs/nonempty"},
        "failure_domain": {"$ref": "#/$defs/nonempty"},
        "revival_predicate": {"type": "string"},
        "evidence_refs": {"$ref": "#/$defs/strings"}
      }
    },
    "obstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obstruction_id", "statement", "route_fingerprint", "core_fingerprint", "evidence_refs", "revival_condition"],
      "properties": {
        "obstruction_id": {"$ref": "#/$defs/nonempty"},
        "statement": {"$ref": "#/$defs/nonempty"},
        "route_fingerprint": {"$ref": "#/$defs/sha"},
        "core_fingerprint": {"$ref": "#/$defs/sha"},
        "evidence_refs": {"$ref": "#/$defs/strings"},
        "revival_condition": {"$ref": "#/$defs/nonempty"}
      }
    }
  }
}
