{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.target-acceptance.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "target_sha256", "interpretation_sha256", "mode", "domains",
    "clauses", "semantic_distinctions", "domain_controls", "payload_sha256"
  ],
  "properties": {
    "schema": {"const": "witsoc.target-acceptance.v1"},
    "target_sha256": {"$ref": "#/$defs/sha"},
    "interpretation_sha256": {"$ref": "#/$defs/sha"},
    "mode": {"enum": ["SOURCE_SYNTHESIS", "OPEN_DISCOVERY", "CLAIM_VERIFICATION", "ARTIFACT_PRODUCTION", "REPAIR", "CROSS_DOMAIN"]},
    "domains": {"$ref": "#/$defs/strings_nonempty"},
    "clauses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/clause"}
    },
    "semantic_distinctions": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/distinction"}
    },
    "domain_controls": {"type": "object"},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings_nonempty": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonempty"},
      "uniqueItems": true
    },
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clause_id", "kind", "statement", "polarity", "verification"],
      "properties": {
        "clause_id": {"$ref": "#/$defs/nonempty"},
        "kind": {"enum": ["ENDPOINT", "QUANTIFIER", "DEFINITION", "ASSUMPTION", "BOUNDARY", "EXCLUSION", "EVIDENCE_STANDARD", "GENERALIZATION"]},
        "statement": {"$ref": "#/$defs/nonempty"},
        "polarity": {"enum": ["MUST_HOLD", "MUST_NOT_HOLD"]},
        "verification": {"$ref": "#/$defs/nonempty"}
      }
    },
    "distinction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distinction_id", "left", "right", "relation", "closure_rule"],
      "properties": {
        "distinction_id": {"$ref": "#/$defs/nonempty"},
        "left": {"$ref": "#/$defs/nonempty"},
        "right": {"$ref": "#/$defs/nonempty"},
        "relation": {"enum": ["NOT_EQUIVALENT", "LEFT_IMPLIES_RIGHT", "RIGHT_IMPLIES_LEFT", "EQUIVALENT"]},
        "closure_rule": {"$ref": "#/$defs/nonempty"}
      }
    }
  }
}
