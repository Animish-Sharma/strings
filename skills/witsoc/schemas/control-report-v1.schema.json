{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.control-report.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "report_id", "kind", "target_sha256", "source_refs", "body",
    "disposition", "status_authority", "payload_sha256"
  ],
  "properties": {
    "schema": {"const": "witsoc.control-report.v1"},
    "report_id": {"$ref": "#/$defs/nonempty"},
    "kind": {
      "enum": [
        "OPERATOR_CONTRACT", "NOVELTY_AUDIT", "INDEPENDENCE_AUDIT",
        "STATE_INDEX", "STATE_CHECKPOINT", "BRIDGE_PLAN", "BRIDGE_GRAPH",
        "STOP_REVIEW", "CAMPAIGN_AUDIT", "LEGACY_AUDIT"
      ]
    },
    "target_sha256": {"oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
    "source_refs": {"$ref": "#/$defs/strings"},
    "body": {"type": "object"},
    "disposition": {"enum": ["READY", "BLOCKED", "WAITING_EXTERNAL", "ADVISORY"]},
    "status_authority": {"const": false},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
