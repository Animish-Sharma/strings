{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.type-registry.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "types"],
  "properties": {
    "schema": {"const": "witsoc.type-registry.v1"},
    "version": {"type": "integer", "minimum": 1},
    "types": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/type_record"}
    }
  },
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "type_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema_path", "schema_id", "owner", "evidence_class", "status_authority", "compatible_from"],
      "properties": {
        "id": {"type": "string", "pattern": "^witsoc\\.[a-z0-9-]+\\.v[0-9]+$"},
        "schema_path": {"type": "string", "pattern": "^(schemas|domains/[a-z0-9-]+/schemas)/[A-Za-z0-9_.-]+\\.json$"},
        "schema_id": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "evidence_class": {"enum": ["CONTROL", "CANDIDATE", "EVIDENCE", "ADMISSION", "HINT"]},
        "status_authority": {"type": "boolean"},
        "compatible_from": {"$ref": "#/$defs/strings"}
      }
    }
  }
}
