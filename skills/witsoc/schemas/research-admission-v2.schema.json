{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.admission.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "admission_id", "target_sha256", "item_id", "status", "frame_admission_ref", "frame_state_sha256", "frame_revision", "evidence_refs", "independent_review_ref", "payload_sha256"],
  "properties": {
    "schema": {"const": "witsoc.admission.v2"},
    "admission_id": {"$ref": "#/$defs/nonempty"},
    "target_sha256": {"$ref": "#/$defs/sha"},
    "item_id": {"$ref": "#/$defs/nonempty"},
    "status": {"enum": ["OPEN", "CONJECTURE", "GAP", "FAILED_ATTEMPT", "REJECTED", "CHECKED_BOUNDED", "SKETCH", "PARTIAL", "CONDITIONAL", "VERIFIED"]},
    "frame_admission_ref": {"$ref": "#/$defs/nonempty"},
    "frame_state_sha256": {"$ref": "#/$defs/sha"},
    "frame_revision": {"type": "integer", "minimum": 0},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "independent_review_ref": {"type": ["string", "null"]},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
