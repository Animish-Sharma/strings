{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.source-map.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_map_id", "target_sha256", "entries", "contradictions", "unresolved", "checked_at", "payload_sha256"],
  "properties": {
    "schema": {"const": "witsoc.source-map.v2"},
    "source_map_id": {"$ref": "#/$defs/nonempty"},
    "target_sha256": {"$ref": "#/$defs/sha"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "contradictions": {"$ref": "#/$defs/strings"},
    "unresolved": {"$ref": "#/$defs/strings"},
    "checked_at": {"$ref": "#/$defs/nonempty"},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "strings": {"type": "array", "items": {"type": "string"}},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_type", "locator", "retrieved_sha256", "claim_supported", "status", "preconditions", "reliability"],
      "properties": {
        "source_id": {"$ref": "#/$defs/nonempty"},
        "source_type": {"$ref": "#/$defs/nonempty"},
        "locator": {"$ref": "#/$defs/nonempty"},
        "retrieved_sha256": {"$ref": "#/$defs/sha"},
        "claim_supported": {"$ref": "#/$defs/nonempty"},
        "status": {"enum": ["ESTABLISHED", "CONDITIONAL", "BOUNDED", "DISPUTED", "CORRECTED", "OPEN", "UNAVAILABLE"]},
        "preconditions": {"$ref": "#/$defs/strings"},
        "reliability": {"enum": ["PRIMARY", "CURATED", "SURVEY", "INFORMAL", "UNKNOWN"]}
      }
    }
  }
}
