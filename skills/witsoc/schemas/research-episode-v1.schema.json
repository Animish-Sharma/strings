{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.research-episode.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "episode_id", "target_sha256", "base_revision", "base_state_sha256",
    "node_id", "claim", "lane", "route", "route_fingerprint", "core_fingerprint",
    "objective", "evaluator", "expected_delta", "return_condition", "campaign_authority",
    "changed_axis", "revival_evidence", "adjudication", "payload_sha256"
  ],
  "properties": {
    "schema": {"const": "witsoc.research-episode.v1"},
    "episode_id": {"$ref": "#/$defs/nonempty"},
    "target_sha256": {"$ref": "#/$defs/sha"},
    "base_revision": {"type": "integer", "minimum": 0},
    "base_state_sha256": {"$ref": "#/$defs/sha"},
    "node_id": {"$ref": "#/$defs/nonempty"},
    "claim": {"$ref": "#/$defs/nonempty"},
    "lane": {"enum": ["RETRIEVE", "REFUTE", "REDUCE", "CONSTRUCT", "TRANSFER", "MEASURE", "VERIFY"]},
    "route": {"$ref": "#/$defs/route"},
    "route_fingerprint": {"$ref": "#/$defs/sha"},
    "core_fingerprint": {"$ref": "#/$defs/sha"},
    "objective": {"$ref": "#/$defs/nonempty"},
    "evaluator": {"$ref": "#/$defs/nonempty"},
    "expected_delta": {"$ref": "#/$defs/nonempty"},
    "return_condition": {"$ref": "#/$defs/nonempty"},
    "stop_condition": {"$ref": "#/$defs/nonempty", "deprecated": true},
    "campaign_authority": {"const": false},
    "changed_axis": {"type": "string"},
    "revival_evidence": {"type": "string"},
    "adjudication": {"type": "object"},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method_family", "mechanism", "structural_object", "required_result", "target_effect", "assumptions"],
      "properties": {
        "method_family": {"$ref": "#/$defs/nonempty"},
        "mechanism": {"$ref": "#/$defs/nonempty"},
        "structural_object": {"$ref": "#/$defs/nonempty"},
        "required_result": {"$ref": "#/$defs/nonempty"},
        "target_effect": {"$ref": "#/$defs/nonempty"},
        "assumptions": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}}
      }
    }
  }
}
