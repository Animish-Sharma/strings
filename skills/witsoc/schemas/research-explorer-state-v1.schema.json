{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.explorer-state.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "explorer_id", "target_sha256", "base_revision",
    "base_state_sha256", "phase", "target_model", "source_coverage",
    "frontier_model", "route_memory", "proposal_refs", "portfolio", "return_assessment",
    "decision", "open_contradictions", "stop_review_ref", "first_failing_gate",
    "payload_sha256"
  ],
  "properties": {
    "schema": {"const": "witsoc.explorer-state.v1"},
    "explorer_id": {"$ref": "#/$defs/nonempty"},
    "target_sha256": {"$ref": "#/$defs/sha"},
    "base_revision": {"type": "integer", "minimum": 0},
    "base_state_sha256": {"$ref": "#/$defs/sha"},
    "phase": {"enum": ["TRIAGE", "WAITING_RETURN", "RETURN_ARBITRATION", "POST_ARBITRATION", "TERMINAL"]},
    "target_model": {"$ref": "#/$defs/target_model"},
    "source_coverage": {"$ref": "#/$defs/source_coverage"},
    "frontier_model": {"$ref": "#/$defs/frontier_model"},
    "route_memory": {"type": "array", "items": {"$ref": "#/$defs/route_memory"}},
    "proposal_refs": {"type": "array", "items": {"$ref": "#/$defs/proposal_ref"}},
    "portfolio": {"$ref": "#/$defs/portfolio"},
    "return_assessment": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/return_assessment"}]},
    "decision": {"$ref": "#/$defs/decision"},
    "open_contradictions": {"$ref": "#/$defs/strings"},
    "stop_review_ref": {"type": ["string", "null"]},
    "first_failing_gate": {"type": "string"},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}, "uniqueItems": true},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frozen", "interpretation", "definitions", "quantifiers", "assumptions", "scope_boundaries", "ambiguities", "variant_refs", "acceptance_clauses", "semantic_distinctions", "domain_controls"],
      "properties": {
        "frozen": {"const": true},
        "interpretation": {"$ref": "#/$defs/nonempty"},
        "definitions": {"$ref": "#/$defs/strings"},
        "quantifiers": {"$ref": "#/$defs/strings"},
        "assumptions": {"$ref": "#/$defs/strings"},
        "scope_boundaries": {"$ref": "#/$defs/strings"},
        "ambiguities": {"type": "array", "items": {"$ref": "#/$defs/ambiguity"}},
        "variant_refs": {"$ref": "#/$defs/strings"},
        "acceptance_clauses": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/acceptance_clause"}},
        "semantic_distinctions": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/semantic_distinction"}},
        "domain_controls": {"type": "object"}
      }
    },
    "acceptance_clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clause_id", "kind", "statement", "polarity", "verification"],
      "properties": {
        "clause_id": {"$ref": "#/$defs/nonempty"},
        "kind": {"enum": ["ENDPOINT", "QUANTIFIER", "DEFINITION", "ASSUMPTION", "BOUNDARY", "EXCLUSION", "EVIDENCE_STANDARD", "GENERALIZATION"]},
        "statement": {"$ref": "#/$defs/nonempty"},
        "polarity": {"enum": ["MUST_HOLD", "MUST_NOT_HOLD"]},
        "verification": {"$ref": "#/$defs/nonempty"}
      }
    },
    "semantic_distinction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distinction_id", "left", "right", "relation", "closure_rule"],
      "properties": {
        "distinction_id": {"$ref": "#/$defs/nonempty"},
        "left": {"$ref": "#/$defs/nonempty"},
        "right": {"$ref": "#/$defs/nonempty"},
        "relation": {"enum": ["NOT_EQUIVALENT", "LEFT_IMPLIES_RIGHT", "RIGHT_IMPLIES_LEFT", "EQUIVALENT"]},
        "closure_rule": {"$ref": "#/$defs/nonempty"}
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ambiguity_id", "statement", "status", "resolution"],
      "properties": {
        "ambiguity_id": {"$ref": "#/$defs/nonempty"},
        "statement": {"$ref": "#/$defs/nonempty"},
        "status": {"enum": ["BLOCKER", "RESOLVED", "RETAINED_NARROW_READING"]},
        "resolution": {"type": "string"}
      }
    },
    "source_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_map_ref", "queries", "unavailable_refs", "correction_refs", "unresolved", "absence_claim_prohibited"],
      "properties": {
        "status": {"enum": ["NOT_STARTED", "PARTIAL", "BOUNDED_COMPLETE"]},
        "source_map_ref": {"type": ["string", "null"]},
        "queries": {"type": "array", "items": {"$ref": "#/$defs/source_query"}},
        "unavailable_refs": {"$ref": "#/$defs/strings"},
        "correction_refs": {"$ref": "#/$defs/strings"},
        "unresolved": {"$ref": "#/$defs/strings"},
        "absence_claim_prohibited": {"const": true}
      }
    },
    "source_query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_id", "question", "corpus", "checked_at", "result", "evidence_refs"],
      "properties": {
        "query_id": {"$ref": "#/$defs/nonempty"},
        "question": {"$ref": "#/$defs/nonempty"},
        "corpus": {"$ref": "#/$defs/nonempty"},
        "checked_at": {"$ref": "#/$defs/nonempty"},
        "result": {"enum": ["FOUND", "NOT_FOUND_WITHIN_SCOPE", "CONTRADICTED", "CORRECTED", "UNAVAILABLE"]},
        "evidence_refs": {"$ref": "#/$defs/strings"}
      }
    },
    "frontier_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges", "minimal_open_core_ids", "frontier_measure", "root_only_exception"],
      "properties": {
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/frontier_node"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/frontier_edge"}},
        "minimal_open_core_ids": {"$ref": "#/$defs/strings"},
        "frontier_measure": {"type": "integer", "minimum": 0},
        "root_only_exception": {"type": "string"}
      }
    },
    "frontier_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "kind", "statement", "status", "dependencies", "evidence_refs", "target_path", "relation_to_parent"],
      "properties": {
        "node_id": {"$ref": "#/$defs/nonempty"},
        "kind": {"enum": ["TARGET", "ENDPOINT", "EQUIVALENT_CORE", "NECESSARY_CONDITION", "SUFFICIENT_CONDITION", "INTERMEDIATE_CLAIM", "DISCRIMINATOR", "EXTERNAL_DEPENDENCY", "EMPIRICAL_SIGNAL", "OPEN_CORE", "REDUCTION", "HYPOTHESIS", "COMPUTATION", "RETRIEVAL", "VERIFICATION_OBLIGATION", "PRODUCT"]},
        "statement": {"$ref": "#/$defs/nonempty"},
        "status": {"$ref": "#/$defs/nonempty"},
        "dependencies": {"$ref": "#/$defs/strings"},
        "evidence_refs": {"$ref": "#/$defs/strings"},
        "target_path": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}, "uniqueItems": true},
        "relation_to_parent": {"enum": ["ROOT", "EQUIVALENT_TO", "NECESSARY_FOR", "SUFFICIENT_FOR", "IMPLIES", "REDUCES_TO", "BLOCKS", "DISCRIMINATES", "SUPPORTS", "EMPIRICAL_ONLY"]}
      }
    },
    "frontier_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_id", "to_id", "relation", "evidence_refs"],
      "properties": {
        "from_id": {"$ref": "#/$defs/nonempty"},
        "to_id": {"$ref": "#/$defs/nonempty"},
        "relation": {"enum": ["EQUIVALENT_TO", "NECESSARY_FOR", "SUFFICIENT_FOR", "IMPLIES", "REDUCES_TO", "BLOCKS", "DISCRIMINATES", "SUPPORTS", "EMPIRICAL_ONLY"]},
        "evidence_refs": {"$ref": "#/$defs/strings"}
      }
    },
    "route_memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_fingerprint", "core_fingerprint", "operator_id", "mechanism", "invariant", "required_result", "failure_signature", "failure_domain", "outcome", "disposition", "revival_predicate", "evidence_refs"],
      "properties": {
        "route_fingerprint": {"$ref": "#/$defs/sha"},
        "core_fingerprint": {"$ref": "#/$defs/sha"},
        "operator_id": {"$ref": "#/$defs/nonempty"},
        "mechanism": {"$ref": "#/$defs/nonempty"},
        "invariant": {"$ref": "#/$defs/nonempty"},
        "required_result": {"$ref": "#/$defs/nonempty"},
        "failure_signature": {"$ref": "#/$defs/nonempty"},
        "failure_domain": {"$ref": "#/$defs/nonempty"},
        "outcome": {"$ref": "#/$defs/nonempty"},
        "disposition": {"enum": ["LIVE", "EXHAUSTED", "REFRAME_REQUIRED", "WAITING", "PENDING"]},
        "revival_predicate": {"type": "string"},
        "evidence_refs": {"$ref": "#/$defs/strings"}
      }
    },
    "proposal_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "payload_sha256"],
      "properties": {
        "proposal_id": {"$ref": "#/$defs/nonempty"},
        "payload_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "portfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "recommended_proposal_id", "represented_method_families", "represented_mechanisms", "diversity_floor_met", "recoupling_threshold"],
      "properties": {
        "entries": {"type": "array", "items": {"$ref": "#/$defs/portfolio_entry"}},
        "recommended_proposal_id": {"type": ["string", "null"]},
        "represented_method_families": {"$ref": "#/$defs/strings"},
        "represented_mechanisms": {"$ref": "#/$defs/strings"},
        "diversity_floor_met": {"type": "boolean"},
        "recoupling_threshold": {"$ref": "#/$defs/unit"}
      }
    },
    "portfolio_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "route_fingerprint", "core_fingerprint", "method_family", "mechanism_fingerprint", "recouples_to", "disposition", "metrics", "score"],
      "properties": {
        "proposal_id": {"$ref": "#/$defs/nonempty"},
        "route_fingerprint": {"$ref": "#/$defs/sha"},
        "core_fingerprint": {"$ref": "#/$defs/sha"},
        "method_family": {"$ref": "#/$defs/nonempty"},
        "mechanism_fingerprint": {"$ref": "#/$defs/sha"},
        "recouples_to": {"$ref": "#/$defs/strings"},
        "disposition": {"enum": ["ELIGIBLE", "RECOUPLED", "REVIVED"]},
        "metrics": {"$ref": "#/$defs/portfolio_metrics"},
        "score": {"$ref": "#/$defs/unit"}
      }
    },
    "portfolio_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_leverage", "expected_information_gain", "checkability", "reversibility", "novelty", "transfer_value", "cost", "recoupling_risk"],
      "properties": {
        "target_leverage": {"$ref": "#/$defs/unit"},
        "expected_information_gain": {"$ref": "#/$defs/unit"},
        "checkability": {"$ref": "#/$defs/unit"},
        "reversibility": {"$ref": "#/$defs/unit"},
        "novelty": {"$ref": "#/$defs/unit"},
        "transfer_value": {"$ref": "#/$defs/unit"},
        "cost": {"$ref": "#/$defs/unit"},
        "recoupling_risk": {"$ref": "#/$defs/unit"}
      }
    },
    "unit": {"type": "number", "minimum": 0, "maximum": 1},
    "return_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["return_ref", "claimed_outcome", "impact", "evidence_ceiling", "affected_node_ids", "accepted_claim_ids", "rejected_claim_ids", "unresolved_contradiction_ids", "route_disposition", "obstruction_disposition", "rationale"],
      "properties": {
        "return_ref": {"$ref": "#/$defs/sha"},
        "claimed_outcome": {"$ref": "#/$defs/nonempty"},
        "impact": {"enum": ["TARGET_PROGRESS", "LOCAL_PRODUCT", "ROUTE_REFUTED", "CORE_SHARPENED", "EMPIRICAL_SIGNAL", "SOURCE_UPDATE", "EXTERNAL_WAIT", "NO_PROGRESS", "CONFLICT"]},
        "evidence_ceiling": {"enum": ["EXACT", "SOURCE_VERIFIED", "COMPUTATIONAL_BOUNDED", "EMPIRICAL", "SEARCH_BOUNDED", "UNKNOWN"]},
        "affected_node_ids": {"$ref": "#/$defs/strings"},
        "accepted_claim_ids": {"$ref": "#/$defs/strings"},
        "rejected_claim_ids": {"$ref": "#/$defs/strings"},
        "unresolved_contradiction_ids": {"$ref": "#/$defs/strings"},
        "route_disposition": {"enum": ["LIVE", "EXHAUSTED", "REFRAME_REQUIRED", "WAITING", "NOT_APPLICABLE"]},
        "obstruction_disposition": {"enum": ["ACCEPT", "REJECT", "DEFER", "NOT_APPLICABLE"]},
        "rationale": {"$ref": "#/$defs/nonempty"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "selected_proposal_id", "basis_refs", "alternatives", "changed_axis", "reason"],
      "properties": {
        "action": {"enum": ["UNDECIDED", "REFRAME_FRONTIER", "EXPAND_FRONTIER", "PAUSE_WITH_FRONTIER", "DIRECT_ANSWER", "WORK_ITEM_TO_GENERATOR", "WORK_ITEM_TO_RESEARCHER", "RETRY_WITH_MUTATION", "DEMOTE", "WAIT_EXTERNAL", "HONEST_STOP"]},
        "selected_proposal_id": {"type": ["string", "null"]},
        "basis_refs": {"$ref": "#/$defs/strings"},
        "alternatives": {"$ref": "#/$defs/strings"},
        "changed_axis": {"type": "string"},
        "reason": {"type": "string"}
      }
    }
  }
}
