{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.explorer-contract.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "contract_id", "target_sha256", "base_revision",
    "base_state_sha256", "phase", "trigger_ref", "limits",
    "allowed_actions", "closure_safe_evidence", "rules", "payload_sha256"
  ],
  "properties": {
    "schema": {"const": "witsoc.explorer-contract.v1"},
    "contract_id": {"$ref": "#/$defs/nonempty"},
    "target_sha256": {"$ref": "#/$defs/sha"},
    "base_revision": {"type": "integer", "minimum": 0},
    "base_state_sha256": {"$ref": "#/$defs/sha"},
    "phase": {"enum": ["TRIAGE", "WAITING_RETURN", "RETURN_ARBITRATION", "POST_ARBITRATION", "TERMINAL"]},
    "trigger_ref": {"type": ["string", "null"]},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_frontier_nodes", "max_live_proposals", "max_route_memory", "max_open_contradictions", "max_source_queries", "max_target_ambiguities"],
      "properties": {
        "max_frontier_nodes": {"type": "integer", "minimum": 1},
        "max_live_proposals": {"type": "integer", "minimum": 1},
        "max_route_memory": {"type": "integer", "minimum": 1},
        "max_open_contradictions": {"type": "integer", "minimum": 0},
        "max_source_queries": {"type": "integer", "minimum": 0},
        "max_target_ambiguities": {"type": "integer", "minimum": 0}
      }
    },
    "allowed_actions": {"$ref": "#/$defs/strings"},
    "closure_safe_evidence": {"$ref": "#/$defs/strings"},
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explorer_cannot_produce_evidence", "return_requires_arbitration", "researcher_successor_is_advisory", "terminal_forbids_pending_work", "bounded_evidence_cannot_exhaust_general_route", "source_absence_is_scoped", "frontier_requires_target_paths", "barriers_require_frontier_expansion", "researcher_has_no_campaign_authority", "pause_preserves_open_frontier", "stop_requires_search_coverage"],
      "properties": {
        "explorer_cannot_produce_evidence": {"const": true},
        "return_requires_arbitration": {"const": true},
        "researcher_successor_is_advisory": {"const": true},
        "terminal_forbids_pending_work": {"const": true},
        "bounded_evidence_cannot_exhaust_general_route": {"const": true},
        "source_absence_is_scoped": {"const": true},
        "frontier_requires_target_paths": {"const": true},
        "barriers_require_frontier_expansion": {"const": true},
        "researcher_has_no_campaign_authority": {"const": true},
        "pause_preserves_open_frontier": {"const": true},
        "stop_requires_search_coverage": {"const": true}
      }
    },
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}, "uniqueItems": true},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
