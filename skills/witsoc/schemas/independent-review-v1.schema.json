{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.independent-review.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "review_id", "target_sha256", "state_revision", "state_sha256",
    "revision_id", "producer", "reviewer", "artifacts", "source_map_sha256",
    "reviewed_item_ids", "checks", "automated_findings", "findings",
    "open_obligations", "verdict", "notes", "status_authority", "payload_sha256"
  ],
  "properties": {
    "schema": {"const": "witsoc.independent-review.v1"},
    "review_id": {"$ref": "#/$defs/nonempty"},
    "target_sha256": {"$ref": "#/$defs/sha"},
    "state_revision": {"type": "integer", "minimum": 0},
    "state_sha256": {"$ref": "#/$defs/sha"},
    "revision_id": {"$ref": "#/$defs/nonempty"},
    "producer": {"$ref": "#/$defs/actor"},
    "reviewer": {"$ref": "#/$defs/actor"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "source_map_sha256": {"oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
    "reviewed_item_ids": {"$ref": "#/$defs/strings"},
    "checks": {"$ref": "#/$defs/checks"},
    "automated_findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "open_obligations": {"$ref": "#/$defs/strings"},
    "verdict": {"enum": ["ACCEPT", "REJECT", "NEEDS_WORK", "INCONCLUSIVE"]},
    "notes": {"type": "string"},
    "status_authority": {"const": false},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}, "uniqueItems": true},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "method_family", "failure_domains"],
      "properties": {
        "actor_id": {"$ref": "#/$defs/nonempty"},
        "method_family": {"$ref": "#/$defs/nonempty"},
        "failure_domains": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}, "uniqueItems": true}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"$ref": "#/$defs/nonempty"},
        "sha256": {"$ref": "#/$defs/sha"},
        "size": {"type": "integer", "minimum": 0}
      }
    },
    "check": {"enum": ["PASS", "FAIL", "NOT_RUN", "NOT_APPLICABLE"]},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_fidelity", "dependencies", "preconditions", "circularity",
        "source_scope", "numeric_scope", "causal_scope", "artifact_completeness",
        "placeholder_scan"
      ],
      "properties": {
        "target_fidelity": {"$ref": "#/$defs/check"},
        "dependencies": {"$ref": "#/$defs/check"},
        "preconditions": {"$ref": "#/$defs/check"},
        "circularity": {"$ref": "#/$defs/check"},
        "source_scope": {"$ref": "#/$defs/check"},
        "numeric_scope": {"$ref": "#/$defs/check"},
        "causal_scope": {"$ref": "#/$defs/check"},
        "artifact_completeness": {"$ref": "#/$defs/check"},
        "placeholder_scan": {"$ref": "#/$defs/check"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "detail", "artifact"],
      "properties": {
        "severity": {"enum": ["BLOCKER", "MAJOR", "MINOR"]},
        "code": {"$ref": "#/$defs/nonempty"},
        "detail": {"$ref": "#/$defs/nonempty"},
        "artifact": {"type": ["string", "null"]}
      }
    }
  }
}
