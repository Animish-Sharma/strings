{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.kernel-event.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "event_id", "target_sha256", "base_revision", "base_state_sha256", "kind", "payload", "payload_sha256"],
  "properties": {
    "schema": {"const": "witsoc.kernel-event.v1"},
    "event_id": {"type": "string", "minLength": 1},
    "target_sha256": {"$ref": "#/$defs/sha"},
    "base_revision": {"type": "integer", "minimum": 0},
    "base_state_sha256": {"$ref": "#/$defs/sha"},
    "kind": {"enum": ["FRONTIER_ADD", "FRONTIER_LINK", "EVIDENCE_RECORD", "OBSTRUCTION_RECORD", "DECISION_RECORD", "ARBITRATION_RECORDED", "EPISODE_ISSUED", "EPISODE_RETURNED", "ROUND_ISSUED", "ROUND_RETURNED", "ADMISSION_IMPORTED", "INVALIDATION_RECORDED"]},
    "payload": {"type": "object"},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
