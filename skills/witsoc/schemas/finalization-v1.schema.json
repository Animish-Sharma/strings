{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.finalization.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "finalization_id", "target_sha256", "state_revision", "state_sha256",
    "activation_receipt_sha256", "terminal_action", "kernel_status", "outcome",
    "assurance_level", "workspace", "artifacts", "review_refs", "admitted_products",
    "unresolved_items", "obstructions", "source_limits", "prohibited_claims",
    "status_authority", "payload_sha256"
  ],
  "properties": {
    "schema": {"const": "witsoc.finalization.v1"},
    "finalization_id": {"$ref": "#/$defs/nonempty"},
    "target_sha256": {"$ref": "#/$defs/sha"},
    "state_revision": {"type": "integer", "minimum": 0},
    "state_sha256": {"$ref": "#/$defs/sha"},
    "activation_receipt_sha256": {"$ref": "#/$defs/sha"},
    "terminal_action": {"enum": ["DIRECT_ANSWER", "WAIT_EXTERNAL", "HONEST_STOP"]},
    "kernel_status": {"type": "string"},
    "outcome": {"type": "string"},
    "assurance_level": {"enum": [
      "SPECULATION", "SEARCH_STOPPED", "WAITING_EXTERNAL", "BOUNDED_VERIFIED",
      "PROOF_SKETCH", "PARTIAL_RESULT", "CONDITIONAL_RESULT", "KERNEL_VERIFIED",
      "INDEPENDENTLY_VERIFIED"
    ]},
    "workspace": {"$ref": "#/$defs/workspace"},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "review_refs": {"type": "array", "items": {"$ref": "#/$defs/review_ref"}},
    "admitted_products": {"type": "array", "items": {"$ref": "#/$defs/frontier"}},
    "unresolved_items": {"type": "array", "items": {"$ref": "#/$defs/frontier"}},
    "obstructions": {"type": "array", "items": {"type": "object"}},
    "source_limits": {"type": "object"},
    "prohibited_claims": {"$ref": "#/$defs/strings"},
    "status_authority": {"const": false},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}, "uniqueItems": true},
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "task_dir_relative"],
      "properties": {
        "root": {"$ref": "#/$defs/nonempty"},
        "task_dir_relative": {"$ref": "#/$defs/nonempty"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {"$ref": "#/$defs/nonempty"},
        "sha256": {"$ref": "#/$defs/sha"},
        "size": {"type": "integer", "minimum": 0}
      }
    },
    "review_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "review_id", "sha256", "verdict", "revision_id"],
      "properties": {
        "path": {"$ref": "#/$defs/nonempty"},
        "review_id": {"$ref": "#/$defs/nonempty"},
        "sha256": {"$ref": "#/$defs/sha"},
        "verdict": {"enum": ["ACCEPT", "REJECT", "NEEDS_WORK", "INCONCLUSIVE"]},
        "revision_id": {"$ref": "#/$defs/nonempty"}
      }
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "kind", "statement", "status", "evidence_refs", "admission_ref"],
      "properties": {
        "item_id": {"$ref": "#/$defs/nonempty"},
        "kind": {"$ref": "#/$defs/nonempty"},
        "statement": {"$ref": "#/$defs/nonempty"},
        "status": {"$ref": "#/$defs/nonempty"},
        "evidence_refs": {"$ref": "#/$defs/strings"},
        "admission_ref": {"type": ["string", "null"]}
      }
    }
  }
}
