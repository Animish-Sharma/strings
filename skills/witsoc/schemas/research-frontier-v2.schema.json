{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.frontier.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "target_sha256", "state_sha256", "revision", "items", "active", "obstruction_refs", "frontier_measure", "payload_sha256"],
  "properties": {
    "schema": {"const": "witsoc.frontier.v2"},
    "target_sha256": {"$ref": "#/$defs/sha"},
    "state_sha256": {"$ref": "#/$defs/sha"},
    "revision": {"type": "integer", "minimum": 0},
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
    "active": {"$ref": "#/$defs/strings"},
    "obstruction_refs": {"$ref": "#/$defs/strings"},
    "frontier_measure": {"type": "integer", "minimum": 0},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "strings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "kind", "statement", "status", "dependencies", "evidence_refs", "admission_ref"],
      "properties": {
        "item_id": {"$ref": "#/$defs/nonempty"},
        "kind": {"$ref": "#/$defs/nonempty"},
        "statement": {"$ref": "#/$defs/nonempty"},
        "status": {"$ref": "#/$defs/nonempty"},
        "dependencies": {"$ref": "#/$defs/strings"},
        "evidence_refs": {"$ref": "#/$defs/strings"},
        "admission_ref": {"type": ["string", "null"]}
      }
    }
  }
}
