{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.capability-graph.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "nodes", "packet_types", "admission_authority", "edge_count", "ok"],
  "properties": {
    "schema": {"const": "witsoc.capability-graph.v1"},
    "version": {"type": "integer", "minimum": 1},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "packet_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "admission_authority": {"type": "string", "minLength": 1},
    "edge_count": {"type": "integer", "minimum": 0},
    "ok": {"const": true}
  },
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "capability_id", "summary", "modes", "roles", "default", "triggers", "inputs", "required_inputs", "optional_inputs", "outputs", "load", "commands", "cost_class", "cost_units", "context_tokens", "priority", "evidence_ceiling", "failure_domains", "resource_keys", "admission_authority"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "capability_id": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "modes": {"$ref": "#/$defs/strings"},
        "roles": {"$ref": "#/$defs/strings"},
        "default": {"type": "boolean"},
        "triggers": {"$ref": "#/$defs/strings"},
        "inputs": {"$ref": "#/$defs/strings"},
        "required_inputs": {"$ref": "#/$defs/strings"},
        "optional_inputs": {"$ref": "#/$defs/strings"},
        "outputs": {"$ref": "#/$defs/strings"},
        "load": {"$ref": "#/$defs/strings"},
        "commands": {"$ref": "#/$defs/strings"},
        "cost_class": {"enum": ["tiny", "small", "medium", "large"]},
        "cost_units": {"type": "integer", "minimum": 1},
        "context_tokens": {"type": "integer", "minimum": 0},
        "priority": {"type": "integer"},
        "evidence_ceiling": {"enum": ["HINT", "CONTROL", "CANDIDATE", "EVIDENCE", "ADMISSION"]},
        "failure_domains": {"$ref": "#/$defs/strings"},
        "resource_keys": {"$ref": "#/$defs/strings"},
        "admission_authority": {"type": "boolean"}
      }
    }
  }
}
