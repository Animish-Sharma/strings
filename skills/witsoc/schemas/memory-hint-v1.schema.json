{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.memory-hint.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "hint_id", "domain", "structural_fingerprint", "features", "content", "provenance_refs", "scope", "non_evidentiary", "created_at", "payload_sha256"],
  "properties": {
    "schema": {"const": "witsoc.memory-hint.v1"},
    "hint_id": {"$ref": "#/$defs/nonempty"},
    "domain": {"$ref": "#/$defs/nonempty"},
    "structural_fingerprint": {"$ref": "#/$defs/sha"},
    "features": {"type": "object", "minProperties": 1},
    "content": {"type": "object", "minProperties": 1},
    "provenance_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "scope": {"type": "object"},
    "non_evidentiary": {"const": true},
    "created_at": {"$ref": "#/$defs/nonempty"},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
