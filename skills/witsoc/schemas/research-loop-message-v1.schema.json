{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.loop-message.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "message_id", "message_type", "target_sha256", "episode_id",
    "episode_sha256", "base_state_sha256", "sender", "recipient", "claim_refs",
    "obligation_refs", "content", "evidence_refs", "supersedes",
    "status_authority", "payload_sha256"
  ],
  "properties": {
    "schema": {"const": "witsoc.loop-message.v1"},
    "message_id": {"$ref": "#/$defs/nonempty"},
    "message_type": {"enum": ["ATTACK_AUTHORIZATION", "LEMMA_REQUEST", "REFRAME_REQUEST", "COUNTEREXAMPLE", "BARRIER_CERTIFICATE", "CLAIM_DELTA", "REVIEW_CHALLENGE", "PROGRESS_REPORT"]},
    "target_sha256": {"$ref": "#/$defs/sha"},
    "episode_id": {"$ref": "#/$defs/nonempty"},
    "episode_sha256": {"$ref": "#/$defs/sha"},
    "base_state_sha256": {"$ref": "#/$defs/sha"},
    "sender": {"enum": ["EXPLORER", "RESEARCHER", "INDEPENDENT_REVIEWER"]},
    "recipient": {"enum": ["EXPLORER", "RESEARCHER", "INDEPENDENT_REVIEWER"]},
    "claim_refs": {"$ref": "#/$defs/strings"},
    "obligation_refs": {"$ref": "#/$defs/strings"},
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "requested_change", "failure_condition"],
      "properties": {
        "summary": {"$ref": "#/$defs/nonempty"},
        "requested_change": {"type": "string"},
        "failure_condition": {"type": "string"}
      }
    },
    "evidence_refs": {"$ref": "#/$defs/strings"},
    "supersedes": {"$ref": "#/$defs/strings"},
    "status_authority": {"const": false},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/nonempty"}, "uniqueItems": true}
  }
}
