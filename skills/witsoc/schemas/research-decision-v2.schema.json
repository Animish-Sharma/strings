{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.decision.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "decision_id", "target_sha256", "action", "basis_refs", "alternatives", "selected", "changed_axis", "reason", "payload_sha256"],
  "properties": {
    "schema": {"const": "witsoc.decision.v2"},
    "decision_id": {"$ref": "#/$defs/nonempty"},
    "target_sha256": {"$ref": "#/$defs/sha"},
    "action": {"$ref": "#/$defs/nonempty"},
    "basis_refs": {"$ref": "#/$defs/strings"},
    "alternatives": {"$ref": "#/$defs/strings"},
    "selected": {"type": ["string", "null"]},
    "changed_axis": {"type": "string"},
    "reason": {"$ref": "#/$defs/nonempty"},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "strings": {"type": "array", "items": {"type": "string"}},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
