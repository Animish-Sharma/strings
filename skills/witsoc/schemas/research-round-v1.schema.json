{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.round.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "round_id", "target_sha256", "base_revision", "base_state_sha256", "episodes", "independence_certificate", "merge_policy", "max_parallel", "payload_sha256"],
  "properties": {
    "schema": {"const": "witsoc.round.v1"},
    "round_id": {"$ref": "#/$defs/nonempty"},
    "target_sha256": {"$ref": "#/$defs/sha"},
    "base_revision": {"type": "integer", "minimum": 0},
    "base_state_sha256": {"$ref": "#/$defs/sha"},
    "episodes": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "object"}},
    "independence_certificate": {"$ref": "#/$defs/certificate"},
    "merge_policy": {"enum": ["DISJOINT_ONLY", "CONFLICT_VISIBLE"]},
    "max_parallel": {"type": "integer", "minimum": 2, "maximum": 8},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "strings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disjoint_nodes", "disjoint_resources", "independent_failure_domains", "rationale"],
      "properties": {
        "disjoint_nodes": {"type": "boolean"},
        "disjoint_resources": {"type": "boolean"},
        "independent_failure_domains": {"type": "boolean"},
        "rationale": {"$ref": "#/$defs/nonempty"},
        "grade": {"enum": ["WEAK", "STRUCTURAL", "MODERATE", "STRONG"]},
        "admission_eligible": {"type": "boolean"},
        "dimensions": {"$ref": "#/$defs/strings"},
        "shared_risks": {"$ref": "#/$defs/strings"},
        "audit_sha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
