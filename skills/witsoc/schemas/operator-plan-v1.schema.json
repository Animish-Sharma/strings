{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.operator-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plan_id", "domain", "target_sha256", "problem_type", "problem_sha256", "role", "objective", "selected", "parallel_groups", "total_cost_units", "estimated_context_tokens", "evidence_ceiling", "uncovered", "advisory", "payload_sha256"],
  "properties": {
    "schema": {"const": "witsoc.operator-plan.v1"},
    "plan_id": {"$ref": "#/$defs/nonempty"},
    "domain": {"$ref": "#/$defs/nonempty"},
    "target_sha256": {"$ref": "#/$defs/sha"},
    "problem_type": {"$ref": "#/$defs/nonempty"},
    "problem_sha256": {"$ref": "#/$defs/sha"},
    "role": {"enum": ["explorer", "generator", "researcher"]},
    "objective": {"type": "string"},
    "selected": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/selected"}},
    "parallel_groups": {"type": "array", "items": {"$ref": "#/$defs/strings"}},
    "total_cost_units": {"type": "integer", "minimum": 1},
    "estimated_context_tokens": {"type": "integer", "minimum": 0},
    "evidence_ceiling": {"enum": ["HINT", "CONTROL", "CANDIDATE", "EVIDENCE"]},
    "uncovered": {"$ref": "#/$defs/strings"},
    "advisory": {"const": true},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "selected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lane", "summary", "activation", "requires_operators", "inputs", "outputs", "preconditions", "doctrine", "commands", "execution", "cost_units", "context_tokens", "evidence_ceiling", "failure_domain", "resource_keys", "stop_conditions"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"},
        "lane": {"$ref": "#/$defs/nonempty"},
        "summary": {"$ref": "#/$defs/nonempty"},
        "activation": {"$ref": "#/$defs/strings"},
        "requires_operators": {"$ref": "#/$defs/strings"},
        "inputs": {"$ref": "#/$defs/strings"},
        "outputs": {"$ref": "#/$defs/strings"},
        "preconditions": {"$ref": "#/$defs/strings"},
        "doctrine": {"$ref": "#/$defs/strings"},
        "commands": {"$ref": "#/$defs/strings"},
        "execution": {"type": "object"},
        "cost_units": {"type": "integer", "minimum": 1},
        "context_tokens": {"type": "integer", "minimum": 0},
        "evidence_ceiling": {"enum": ["HINT", "CONTROL", "CANDIDATE", "EVIDENCE"]},
        "failure_domain": {"$ref": "#/$defs/nonempty"},
        "resource_keys": {"$ref": "#/$defs/strings"},
        "stop_conditions": {"$ref": "#/$defs/strings"}
      }
    }
  }
}
