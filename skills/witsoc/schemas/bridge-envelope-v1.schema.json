{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.bridge-envelope.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "envelope_id", "source", "destination", "message_type", "target_sha256", "correlation_id", "causation_id", "content_sha256", "payload", "evidence_refs", "payload_sha256"],
  "properties": {
    "schema": {"const": "witsoc.bridge-envelope.v1"},
    "envelope_id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "destination": {"type": "string", "minLength": 1},
    "message_type": {"type": "string", "minLength": 1},
    "target_sha256": {"$ref": "#/$defs/sha"},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"oneOf": [{"type": "string"}, {"type": "null"}]},
    "content_sha256": {"$ref": "#/$defs/sha"},
    "payload": {"type": "object"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
