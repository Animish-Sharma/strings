{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.operator-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "domain", "version", "operators"],
  "properties": {
    "schema": {"const": "witsoc.operator-manifest.v1"},
    "domain": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "operators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operator"}}
  },
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "lane", "roles", "default", "triggers", "requires_operators", "requires_capabilities", "inputs", "outputs", "preconditions", "doctrine", "commands", "execution", "cost_units", "priority", "evidence_ceiling", "failure_domain", "resource_keys", "stop_conditions"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "summary": {"type": "string", "minLength": 1},
        "lane": {"enum": ["RETRIEVE", "REFUTE", "REDUCE", "CONSTRUCT", "TRANSFER", "MEASURE", "VERIFY"]},
        "roles": {"$ref": "#/$defs/strings"},
        "default": {"type": "boolean"},
        "triggers": {"$ref": "#/$defs/strings"},
        "requires_operators": {"$ref": "#/$defs/strings"},
        "requires_capabilities": {"$ref": "#/$defs/strings"},
        "inputs": {"$ref": "#/$defs/strings"},
        "outputs": {"$ref": "#/$defs/strings"},
        "preconditions": {"$ref": "#/$defs/strings"},
        "doctrine": {"$ref": "#/$defs/strings"},
        "commands": {"$ref": "#/$defs/strings"},
        "execution": {"$ref": "#/$defs/execution"},
        "cost_units": {"type": "integer", "minimum": 1, "maximum": 8},
        "priority": {"type": "integer"},
        "evidence_ceiling": {"enum": ["HINT", "CONTROL", "CANDIDATE", "EVIDENCE"]},
        "failure_domain": {"type": "string", "minLength": 1},
        "resource_keys": {"$ref": "#/$defs/strings"},
        "stop_conditions": {"$ref": "#/$defs/strings"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "backend_classes", "command_template", "binding_fields", "acceptance_checks", "falsifier", "may_wait_external"],
      "properties": {
        "mode": {"enum": ["LOCAL_TOOL", "STRUCTURED_REASONING", "HYBRID", "EXTERNAL_PROTOCOL"]},
        "backend_classes": {"$ref": "#/$defs/strings"},
        "command_template": {"type": "string"},
        "binding_fields": {"$ref": "#/$defs/strings"},
        "acceptance_checks": {"$ref": "#/$defs/strings"},
        "falsifier": {"type": "string", "minLength": 1},
        "may_wait_external": {"type": "boolean"}
      }
    }
  }
}
