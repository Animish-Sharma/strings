{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.research-delta.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "delta_id", "episode_id", "episode_sha256", "target_sha256",
    "base_revision", "base_state_sha256", "outcome", "evidence_refs",
    "frontier_measure_before", "frontier_measure_after", "new_frontier",
    "new_obstruction", "admission_ref", "independent_review",
    "remaining_obstruction", "revival_condition", "next_proposals", "changed_axis",
    "payload_sha256"
  ],
  "properties": {
    "schema": {"const": "witsoc.research-delta.v1"},
    "delta_id": {"$ref": "#/$defs/nonempty"},
    "episode_id": {"$ref": "#/$defs/nonempty"},
    "episode_sha256": {"$ref": "#/$defs/sha"},
    "target_sha256": {"$ref": "#/$defs/sha"},
    "base_revision": {"type": "integer", "minimum": 0},
    "base_state_sha256": {"$ref": "#/$defs/sha"},
    "outcome": {"enum": ["ADMITTED_PRODUCT", "CANDIDATE_PRODUCT", "STRICT_REDUCTION", "FALSIFICATION", "ROUTE_REFUTED", "NEW_OBSTRUCTION", "NO_PROGRESS", "WAITING_EXTERNAL"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "frontier_measure_before": {"type": "integer", "minimum": 0},
    "frontier_measure_after": {"type": "integer", "minimum": 0},
    "new_frontier": {"type": "array", "items": {"type": "object"}},
    "new_obstruction": {"oneOf": [{"type": "object"}, {"type": "null"}]},
    "admission_ref": {"oneOf": [{"type": "string"}, {"type": "null"}]},
    "independent_review": {"oneOf": [{"type": "object"}, {"type": "null"}]},
    "remaining_obstruction": {"type": "string"},
    "revival_condition": {"type": "string"},
    "next_proposals": {"type": "array", "items": {"type": "object"}},
    "changed_axis": {"type": "string"},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
