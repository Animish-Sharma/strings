{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "witsoc.round-delta.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "round_delta_id", "round_id", "round_sha256", "target_sha256", "base_revision", "base_state_sha256", "deltas", "conflicts", "aggregate_outcome", "payload_sha256"],
  "properties": {
    "schema": {"const": "witsoc.round-delta.v1"},
    "round_delta_id": {"$ref": "#/$defs/nonempty"},
    "round_id": {"$ref": "#/$defs/nonempty"},
    "round_sha256": {"$ref": "#/$defs/sha"},
    "target_sha256": {"$ref": "#/$defs/sha"},
    "base_revision": {"type": "integer", "minimum": 0},
    "base_state_sha256": {"$ref": "#/$defs/sha"},
    "deltas": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "conflicts": {"type": "array", "items": {"type": "object"}},
    "aggregate_outcome": {"enum": ["MERGEABLE", "CONFLICT", "WAITING_EXTERNAL"]},
    "payload_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
